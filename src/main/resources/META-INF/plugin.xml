<idea-plugin>
    <id>io.dsh.jb.deepseek-harness</id>
    <name>Community DSH Agent</name>
    <vendor>DeepSeekHarnessForJB community</vendor>

    <description><![CDATA[
    Community plugin that embeds a DeepSeek Harness (DSH) coding agent in IntelliJ IDEA
    and Android Studio: a chat tool window, agentic editing with diff preview and apply,
    plan mode, permission dialogs, and project-wide search/edit/shell capabilities.
    ]]></description>

    <!-- Platform-only dependency: loads in IntelliJ IDEA AND Android Studio. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DSH Community"
                    anchor="right"
                    factoryClass="io.dsh.jb.ui.DshToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowStructure"/>
        <applicationConfigurable
                parentId="tools"
                id="io.dsh.jb.settings"
                displayName="DeepSeek Harness"
                instance="io.dsh.jb.settings.DshSettingsConfigurable"/>
    </extensions>

    <actions>
        <!-- Roadmap item 11 remainder: editor-popup context actions on a selection. -->
        <group id="io.dsh.jb.EditorSelectionGroup" text="DeepSeek Harness" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="io.dsh.jb.AskSelection"
                    class="io.dsh.jb.ui.AskSelectionAction"
                    text="DSH: Ask about Selection"/>
            <action id="io.dsh.jb.ExplainSelection"
                    class="io.dsh.jb.ui.ExplainSelectionAction"
                    text="DSH: Explain Selection"/>
            <action id="io.dsh.jb.FixSelection"
                    class="io.dsh.jb.ui.FixSelectionAction"
                    text="DSH: Fix Selection"/>
        </group>
    </actions>
</idea-plugin>
